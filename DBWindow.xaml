<Window x:Class="PCAdministration_.DBWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCAdministration_"
        mc:Ignorable="d"
        Title="DBWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Верхняя панель вкладок -->
            <RowDefinition Height="Auto"/>
            <!-- Строка поиска -->
            <RowDefinition Height="Auto"/>
            <!-- Основной контент -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Область таблицы -->
            <ColumnDefinition Width="*"/>
            <!-- Правая панель действий -->
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Стили для кнопок -->
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#9588FF"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ (ВКЛАДКИ) -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="кабинеты" Click="TabButton_Click" FontSize="12" Tag="cabinet"/>
            <Button Content="компьютеры" Click="TabButton_Click" FontSize="12" Tag="pc"/>
            <Button Content="проблемы" Click="TabButton_Click" FontSize="12" Tag="problem"/>
            <Button Content="архивные записи" Click="TabButton_Click" FontSize="12" Tag="archive"/>
        </StackPanel>

        <!-- СТРОКА ПОИСКА -->
        <TextBox Grid.Row="1" Grid.Column="0" Margin="5,0,5,15" Height="30" 
                 VerticalContentAlignment="Center" Padding="5,0"
                 Foreground="Gray" Text="Введите символы для поиска"/>

        <!-- ЦЕНТРАЛЬНАЯ ОБЛАСТЬ (ДАННЫЕ ТАБЛИЦЫ) -->
        <Grid Grid.Row="2" Grid.Column="0" Background="#D3D3D3" Margin="5">
            <!-- Элемент для отображения табличных данных -->
            <DataGrid x:Name="MainDataGrid" AutoGenerateColumns="True" Background="Transparent" 
                      BorderThickness="0" SelectedCellsChanged="MainDataGrid_SelectedCellsChanged"
                      IsReadOnly="True"/>

            <!-- Заглушка (текст со скриншота) -->

            <!-- Контекстное и главное меню (заглушки) -->
            
        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ (КНОПКИ ДЕЙСТВИЙ) -->
        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Content="Добавить" Click="Add_Click" Height="40" Margin="0,8"/>
            <Button Content="печать" Click="Print_Click" Height="40" Margin="0,8"/>
            <Button Content="изменить" Click="Edit_Click" Height="40" Margin="0,8"/>
            <Button Content="удалить" Click="Delete_Click" Height="40" Margin="0,8"/>
        </StackPanel>
    </Grid>
</Window>
